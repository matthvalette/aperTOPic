# Copy to .env and fill in. Every setting in src/parltopics/config.py can be overridden here.

# TypeSafe Jev (https://console.typesafe.ai)
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.14.0

# Apertus through the Keera gateway (OpenAI-compatible)
APERTUS_API_KEY=
# APERTUS_BASE_URL=https://gateway.keera.ch/api/v1
# APERTUS_MODEL=apertus-v1-5-70b

# Labelled data from files.openparldata.ch/hackapertus (default: data/hackapertus in this folder)
# DATA_DIR=data/hackapertus
# BODIES_FILE=data/exports/bodies.ndjson.gz
